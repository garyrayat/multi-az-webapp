{
  "mcpServers": {

    "kubernetes": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-kubernetes"],
      "env": {
        "KUBECONFIG": "/home/sre/.kube/config",
        "K8S_NAMESPACE": "webapp",
        "K8S_CONTEXT": "gke_thd-platform-prod_us-central1_prod-webapp-gke"
      }
    },

    "google-cloud-monitoring": {
      "command": "uvx",
      "args": ["gcp-mcp-server@latest", "--service", "monitoring"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/var/secrets/gcp-sre-sa.json",
        "GCP_PROJECT_ID": "thd-platform-prod",
        "GCP_REGION": "us-central1",
        "MONITORING_WINDOW_SECONDS": "3600"
      }
    },

    "google-cloud-trace": {
      "command": "uvx",
      "args": ["gcp-mcp-server@latest", "--service", "trace"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/var/secrets/gcp-sre-sa.json",
        "GCP_PROJECT_ID": "thd-platform-prod",
        "TRACE_LOOKBACK_MINUTES": "60"
      }
    },

    "google-cloud-logging": {
      "command": "uvx",
      "args": ["gcp-mcp-server@latest", "--service", "logging"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/var/secrets/gcp-sre-sa.json",
        "GCP_PROJECT_ID": "thd-platform-prod",
        "LOG_BUCKET": "thd-platform-prod-sre-logs",
        "DEFAULT_LOG_LINES": "200"
      }
    },

    "pagerduty": {
      "command": "npx",
      "args": ["-y", "@pagerduty/mcp-server"],
      "env": {
        "PAGERDUTY_API_KEY": "${PAGERDUTY_API_KEY}",
        "PAGERDUTY_FROM_EMAIL": "sre-automation@homedepot.com",
        "DEFAULT_ESCALATION_POLICY": "P3WEBAPP",
        "ONCALL_SCHEDULE_ID": "SCHED_WEBAPP_SRE"
      }
    },

    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    }
  }
}
